# Bot/bot2/.env.example — copy to .env and fill in your values
BOT_TOKEN=your_discord_bot_token_here
LOOKISM_OWNER_IDS=123456789012345678,234567890123456789
LOOKISM_SQLITE_PATH=  # unused now that Firestore is the backend; kept only for legacy fallback
SUPABASE_URL=         # optional, only needed if using Supabase sync
SUPABASE_SERVICE_ROLE_KEY=  # optional, only needed if using Supabase sync
GANG_WAR_PREP_SECONDS=86400
GANG_WAR_BATTLE_SECONDS=86400

# Firestore (required) — persistence backend for all bot data
FIREBASE_PROJECT_ID=your-firebase-project-id
# Provide ONE of the two below. On hosts where you can't upload a file (e.g.
# most game panels), paste the entire service-account JSON key content into
# FIREBASE_CREDENTIALS_JSON instead of using FIREBASE_CREDENTIALS_PATH.
FIREBASE_CREDENTIALS_PATH=/absolute/path/to/firebase-service-account.json
FIREBASE_CREDENTIALS_JSON=
